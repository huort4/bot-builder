# =============================================================================
# AIDahl v2 — فایل نمونه‌ی تنظیمات
# این فایل را با نام  .env  کپی کنید و مقادیر را پر کنید. هرگز .env را commit نکنید.
# =============================================================================

# ====================== Core (الزامی) ======================
# توکن ربات از @BotFather
BOT_TOKEN=
# آدرس پروژه‌ی Supabase، مثل https://xxxx.supabase.co
SUPABASE_URL=
# باید کلید service_role باشد (فقط روی سرور). کلید anon را نگذارید
# و برای رفع خطا هرگز RLS را غیرفعال نکنید.
SUPABASE_KEY=

# ====================== Dahl / کلید مشترک ======================
# کلید مشترک Dahl برای کاربرانی که کلید شخصی ندارند (خالی = فقط BYOK)
DAHL_API_KEY=
# اگر false باشد، هر کاربر باید کلید شخصی خودش را ثبت کند
ALLOW_SHARED_KEY=true

# ====================== سهمیه توکن ======================
DEFAULT_DAILY_TOKEN_QUOTA=50000
DEFAULT_LIFETIME_TOKEN_QUOTA=3000000
# هشدار وقتی این درصد از سهمیه‌ی کل مصرف شد
LIFETIME_WARN_PCT=75
# اگر true باشد سهمیه‌ی روزانه روی کلیدهای شخصی هم اعمال می‌شود
QUOTA_APPLIES_TO_OWN_KEYS=false

# ====================== تاریخچه و ذخیره‌سازی ======================
# تعداد پیام‌هایی که به مدل فرستاده می‌شود (کاربر می‌تواند 5/10/20/40 انتخاب کند)
HISTORY_LIMIT=20
# حداکثر پیام نگه‌داشته‌شده در گفتگوی فعال؛ بقیه پاک می‌شوند
KEEP_MESSAGES_IN_ACTIVE_CHAT=40

# ====================== استریم ======================
STREAMING_ENABLED=true
# حداقل فاصله‌ی ویرایش پیام در استریم (ثانیه)؛ کمتر از 1 باعث flood limit می‌شود
STREAM_EDIT_INTERVAL=1.2

# ====================== ادمین ======================
# آیدی عددی تلگرام ادمین‌ها، با کاما جدا شوند: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# ====================== امنیت ======================
# رمزنگاری کلیدهای شخصی کاربران در دیتابیس (نیاز به cryptography)
# هر رشته‌ی تصادفی بلند؛ ساخت:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# هشدار: اگر این مقدار گم شود، کلیدهای ذخیره‌شده‌ی کاربران قابل بازیابی نیستند.
# خالی = کلیدها به‌صورت متن ساده ذخیره می‌شوند.
KEY_ENCRYPTION_SECRET=

# Base URL سفارشی (provider «Custom»): پیش‌فرض فقط https و آی‌پی عمومی
# فقط برای خودمیزبانی (مثلاً http://localhost:11434/v1) و کاربران مورد اعتماد true کنید
CUSTOM_URL_ALLOW_PRIVATE=false
# اختیاری: فهرست دامنه‌های مجاز برای Base URL سفارشی، با کاما (خالی = هر دامنه‌ی عمومی)
CUSTOM_URL_ALLOWED_HOSTS=

# ====================== Manus Agent (اختیاری) ======================
MANUS_BASE_URL=https://api.manus.ai
# کلید مشترک Manus برای همه‌ی کاربران (خالی = هر کاربر کلید خودش را ثبت می‌کند)
MANUS_API_KEY=
# standard | lite | max
MANUS_DEFAULT_PROFILE=standard
# خالی بگذارید؛ کدهای نامعتبر مثل fa توسط Manus رد می‌شوند
MANUS_LOCALE=
# حداکثر زمان انتظار برای هر تسک (ثانیه)
MANUS_TIMEOUT_SEC=90
MANUS_POLL_INTERVAL=4
# تعداد تسک هم‌زمان و ظرفیت صف
MANUS_MAX_CONCURRENT=2
MANUS_QUEUE_MAX=15
# مدت زمانی که پیام‌های بعدی ادامه‌ی همان تسک حساب می‌شوند (ثانیه)
MANUS_FOLLOWUP_TTL_SEC=7200
# قفل‌های گیرکرده بعد از این مدت آزاد می‌شوند (ثانیه)
MANUS_STALE_LOCK_SEC=180
# کلید Manus فقط به این دامنه‌ها (و زیردامنه‌هایشان) فرستاده می‌شود
MANUS_TRUSTED_HOSTS=manus.ai,manus.im,manuscdn.com
# حداکثر حجم فایل دانلودی از Manus (مگابایت)
MANUS_MAX_DOWNLOAD_MB=25

# ====================== رابط کاربری ======================
PROMPTOPIA_URL=https://mohsen-niksirat.github.io/promptopia/
PROMPTOPIA_LABEL=📚 پرامپت‌های آماده
