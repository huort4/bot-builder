# ====================== Core ======================
BOT_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
BOT_VERSION=2.0.0-optimized

# ====================== Dahl / Shared ======================
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1
ALLOW_SHARED_KEY=true

# ====================== Quotas ======================
TOKEN_QUOTA=1000000
DEFAULT_DAILY_TOKEN_QUOTA=50000
DEFAULT_LIFETIME_TOKEN_QUOTA=3000000
LIFETIME_WARN_PCT=75
QUOTA_APPLIES_TO_OWN_KEYS=false

# ====================== History & Storage ======================
HISTORY_LIMIT=20
KEEP_MESSAGES_IN_ACTIVE_CHAT=40
SKIP_USAGE_TABLE=true

# ====================== Streaming ======================
STREAMING_ENABLED=true
STREAM_EDIT_INTERVAL=1.2

# ====================== Admin ======================
ADMIN_TELEGRAM_IDS=

# ====================== Manus Agent ======================
MANUS_API_KEY=
MANUS_BASE_URL=https://api.manus.ai
MANUS_DEFAULT_PROFILE=standard
MANUS_TIMEOUT_SEC=90
MANUS_POLL_INTERVAL=4
MANUS_LOCALE=
MANUS_MAX_CONCURRENT=2
MANUS_QUEUE_MAX=15
MANUS_MAX_PER_USER=1
MANUS_FOLLOWUP_TTL_SEC=7200
MANUS_STALE_LOCK_SEC=180

# ====================== Security ======================
# Optional: 32-byte base64 key for encrypting user API keys at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ====================== UI ======================
PROMPTOPIA_URL=https://mohsen-niksirat.github.io/promptopia/
PROMPTOPIA_LABEL=📚 پرامپت‌های آماده